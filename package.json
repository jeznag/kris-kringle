{
  "name": "kriskringle",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply kris-kringle --local",
    "db:migrate:remote": "wrangler d1 migrations apply kris-kringle --remote",
    "db:backup": "scripts/backup-db.sh"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
